{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=qabilhire;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "QabilHire",
    "Audience": "QabilHire",
    "Key": "DEVELOPMENT_ONLY_REPLACE_WITH_USER_SECRET_32_CHARS",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://qabil-hire-ui-rho.vercel.app"
    ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "Email": {
    "FromAddress": "no-reply@qabilhire.com",
    "Smtp": {
      "Port": 587,
      "EnableSsl": true
    }
  },
  "Supabase": {
    "Url": "",
    "ServiceRoleKey": "",
    "ResumesBucket": ""
  },
  "Groq": {
    "BaseUrl": "",
    "ApiKey": "",
    "Model": ""
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowMinutes": 1
    },
    "Registration": {
      "PermitLimit": 5,
      "WindowMinutes": 5
    },
    "Session": {
      "PermitLimit": 20,
      "WindowMinutes": 1
    },
    "PasswordRecovery": {
      "PermitLimit": 5,
      "WindowMinutes": 15
    }
  },
  "Logging": {
    "File": {
      "Path": "logs/qabilhire.log"
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
